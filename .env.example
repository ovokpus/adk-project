# Copy to .env (gitignored). Without credentials the console still runs: agents can be
# inspected, schemas validated and callbacks exercised, but "Run" returns 503 (not simulated).

# Option A: Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Option B: Vertex AI / Agent Platform with Application Default Credentials
# (see docker-compose.vertex.yml). The original lab used GOOGLE_GENAI_USE_ENTERPRISE=true.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

MODEL=gemini-3.5-flash
# Send callback logs to Google Cloud Logging (needs GCP credentials)
ENABLE_CLOUD_LOGGING=false

API_PORT=8000
FRONTEND_PORT=3000
